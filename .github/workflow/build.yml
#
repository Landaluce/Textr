# Copy this file to .github/workflows/build.yml in the Textr repo.
#
# What it does: on every version tag (v*), builds a standalone Textr binary
# for Linux, Windows, and macOS, then attaches all three to the GitHub release.
# Free for public repos. No Mac or Windows machine needed on your end.
#
# Prerequisites in the repo:
#   - requirements.txt installs cleanly on all three OSes
#     (evdev is already correctly marked sys_platform == "linux")
#   - entry point is main.py  (project.scripts: textr = "main:main")
#
# Usage:
#   git tag v0.2.0 && git push origin v0.2.0
#   -> binaries appear on the GitHub release page a few minutes later.

name: build

on:
  push:
    tags:
      - "v*"

jobs:
  build:
    strategy:
      matrix:
        include:
          - os: ubuntu-latest
            artifact_name: textr-linux
            binary_path: dist/textr
            # --hidden-import: pynput picks its backend via dynamic imports,
            # which PyInstaller's static analysis misses. (Do NOT use
            # --collect-submodules pynput instead: it imports pynput at build
            # time, which needs an X server / display and fails on headless
            # CI runners.)
            pyinstaller_args: --onefile --name textr --paths . --hidden-import=pynput.keyboard._xorg --hidden-import=pynput.mouse._xorg
          - os: windows-latest
            artifact_name: textr-windows
            binary_path: dist/Textr.exe
            # --windowed: no console window for a tray app.
            pyinstaller_args: --onefile --windowed --name Textr --paths . --hidden-import=pynput.keyboard._win32 --hidden-import=pynput.mouse._win32
          - os: macos-latest
            artifact_name: textr-macos
            binary_path: dist/Textr.app
            pyinstaller_args: --onefile --windowed --name Textr --paths . --hidden-import=pynput.keyboard._darwin --hidden-import=pynput.mouse._darwin
    runs-on: ${{ matrix.os }}
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt pyinstaller

      - name: Smoke-test imports
        run: python -c "import daemon, ui, main; print('imports ok')"

      - name: Build with PyInstaller
        run: pyinstaller --noconfirm ${{ matrix.pyinstaller_args }} main.py

      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: ${{ matrix.artifact_name }}
          path: ${{ matrix.binary_path }}

  release:
    needs: build
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - name: Download all binaries
        uses: actions/download-artifact@v4
        with:
          path: binaries

      - name: Zip the macOS .app (directories can't be release attachments)
        run: |
          cd binaries/textr-macos
          zip -qr ../Textr-macos.zip Textr.app
          cd ../..

      - name: Attach to GitHub release
        uses: softprops/action-gh-release@v2
        with:
          # The tag (v0.2.0) becomes the release; files attached below it.
          files: |
            binaries/textr-linux/textr
            binaries/textr-windows/Textr.exe
            binaries/Textr-macos.zip